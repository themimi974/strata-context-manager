+    SEG_HEAD_SEAM, SEG_TAIL_SEAM, SEG_MIN_TOKENS = 8, 4, 256   # F3.3
+
+    def resolve_files(self, files, messages, tools, kwargs, ids, has_images=False) -> dict:
+        """F3.2/F3.3: [{"message": I, "start": c0, "end": c1, "id": ID}, ...] -> {"spans": [[a, e, id], ...]}.
+
+        The stored / composed part of a file is its tokens minus a seam at each edge, which is always read normally: 8
+        tokens at the start plus STRATA_SEG_HEAD_PCT percent of the file (default 15: re-reading each file's start is
+        what kept several files in a row close to a normal read), and 4 tokens at the end.  The same rule serves the
+        capture and the compose, and the engine checks the stored tokens, so a different rendering only costs a normal
+        read.  Files under SEG_MIN_TOKENS stored tokens are left out."""
+        pct = float(os.environ.get("STRATA_SEG_HEAD_PCT", "15")) / 100.0
+        spans = []
+        for f in files:
+            r = self.resolve_segment({"message": f.get("message"), "start": f.get("start"), "end": f.get("end")},
+                                     messages, tools, kwargs, ids, has_images)
+            toks = r.get("tokens") if isinstance(r, dict) else None
+            ident = re.sub(r"[^0-9A-Za-z_-]", "", str(f.get("id", "")))[:64]
+            if not toks or not ident:
+                continue
+            f0, f1 = toks
+            a = f0 + self.SEG_HEAD_SEAM + int(round(pct * (f1 - f0)))
+            e = f1 - self.SEG_TAIL_SEAM
+            if e - a < self.SEG_MIN_TOKENS:
+                continue
+            spans.append([a, e, ident])
+        spans.sort()
+        return {"spans": spans}
