                      uint64_t ple_floats, const std::string& dir, std::string& err);
-/// F1.3 compose: instead of reading [a, e), set the GDN state to W_after + T (W - W_before) (conv rows: the capture's),
-/// write the captured K/V into cells [a, e) re-rotated by a - captured_a, the pooled rows likewise (the spare slot moved
-/// to row e/4), and the PLE history.  The caller sets ple_prev.  `ms`: GPU time of the composition.
+/// F1.3/F3.1 compose: instead of reading [a, e), set the GDN state to W_after + T (W - W_before) (conv rows: the
+/// capture's), write the captured K/V into cells [a, e) re-rotated by a - captured_a (any shift), append the captured raw
+/// indexer keys at [a, e) (the engine's own batched append: blocks pooled exactly as a read would, at any alignment), and
+/// the PLE history.  The caller sets ple_prev.  `ms`: GPU time of the composition.
 bool segcomp_apply(const std::string& dir, int64_t a, int64_t e, float* gdn_state, int64_t n_gdn,
                    const std::vector<SegQsa>& layers, int page_size, float* ple_hist, uint64_t ple_floats, double* ms,
                    std::string& err, bool use_t = true);
