 #include <vector>
 #if defined(cudaMemsetAsync) && !defined(cudaMemset2DAsync)   // the HIP build maps cuda* names by macro
@@ -37,8 +38,44 @@ SegCap& segcap() {
     return s;
 }
 
-bool segcap_begin(int64_t n_gdn, int64_t max_t, std::string& err) {
+namespace {
+const float* g_knorm[64] = {};
+}
+
+void segcap_register_knorm(int64_t qsa_ord, const float* w) {
+    if (qsa_ord >= 0 && qsa_ord < 64) g_knorm[qsa_ord] = w;
+}
+
+const float* segcap_knorm(int64_t qsa_ord) {
+    return qsa_ord >= 0 && qsa_ord < 64 ? g_knorm[qsa_ord] : nullptr;
+}
+
+void segcap_qsa_raw(int64_t qsa_ord, const float* idx_raw, int64_t p0, int64_t T, void* stream) {
     SegCap& s = segcap();
+    if (!s.active || s.raw == nullptr || qsa_ord < 0 || qsa_ord >= s.n_qsa) return;
+    const int64_t lo = std::max(p0, s.span_a), hi = std::min(p0 + T, s.span_a + s.span_n);
+    if (hi <= lo) return;
+    cudaMemcpyAsync(s.raw + ((size_t) qsa_ord * s.span_n + (lo - s.span_a)) * 128, idx_raw + (size_t) (lo - p0) * 128,
+                    (size_t) (hi - lo) * 128 * sizeof(float), cudaMemcpyDeviceToDevice, (cudaStream_t) stream);
+    s.raw_rows += hi - lo;
+}
+
+bool segcap_begin(int64_t n_gdn, int64_t max_t, std::string& err, int64_t n_qsa, int64_t a, int64_t n) {
+    SegCap& s = segcap();
+    s.n_qsa = s.span_n = s.raw_rows = 0;
+    if (n_qsa > 0 && n > 0) {
+        const int64_t need = n_qsa * n * 128;
+        if (need > s.raw_cap) {
+            if (s.raw) cudaFree(s.raw);
+            s.raw = nullptr;
+            s.raw_cap = 0;
+            if (!ok(cudaMalloc(&s.raw, (size_t) need * sizeof(float)), "raw", err)) return false;
+            s.raw_cap = need;
+        }
+        s.n_qsa = n_qsa;
+        s.span_a = a;
+        s.span_n = n;
+    }
     if (n_gdn <= 0 || max_t <= 0) {
         err = "segcap: nothing to capture";
         return false;
