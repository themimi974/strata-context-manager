 };
 
 SegCap& segcap();
 
 /// Allocates (once, grow-only) and sets every layer's operator to the identity. max_t: the largest chunk expected.
-bool segcap_begin(int64_t n_gdn, int64_t max_t, std::string& err);
+/// n_qsa / a / n: the QSA layers and the span whose raw indexer keys are kept (n_qsa 0: none).
+bool segcap_begin(int64_t n_gdn, int64_t max_t, std::string& err, int64_t n_qsa = 0, int64_t a = 0, int64_t n = 0);
