+/// The indexer k_norm weight of each QSA layer (session ordinal), recorded by every prompt read: a load needs it.
+void segcap_register_knorm(int64_t qsa_ord, const float* w);
+const float* segcap_knorm(int64_t qsa_ord);
 /// One GDN layer's chunk: copies h, zeroes its v columns and runs the state-only recurrence into T[gdn_ord].
 void segcap_layer(int64_t gdn_ord, const float* h, const float* gate, const float* beta, int64_t T, void* stream);
 /// Synchronizes, writes T (n_gdn x layer floats) to `path`, turns the capture off.
@@ -45,15 +58,20 @@ struct SegQsa {
