diff --git a/engine/src/prefill/segcap.cpp b/engine/src/prefill/segcap.cpp
new file mode 100644
index 000000000..4d484db7d
--- /dev/null
+++ b/engine/src/prefill/segcap.cpp
@@ -0,0 +1,112 @@
+// src/prefill/segcap.cpp - see include/strata/prefill/segcap.hpp (F1 research build).
+#include "strata/prefill/segcap.hpp"
+#include "strata/prefill/kernels.hpp"
+#include <cuda_runtime.h>
+#include <cstdio>
+#include <vector>
+#if defined(cudaMemsetAsync) && !defined(cudaMemset2DAsync)   // the HIP build maps cuda* names by macro
+#define cudaMemset2DAsync hipMemset2DAsync   // not in the hip_compat list
+#endif
+
+namespace strata::prefill {
+namespace {
+constexpr int64_t S = 128, HK = 16, HV = 48, C = 10240;
+constexpr uint64_t NST = (uint64_t) S * HV * S;   // one layer's recurrent state, floats
+
+bool ok(cudaError_t e, const char* what, std::string& err) {
+    if (e == cudaSuccess) return true;
+    err = std::string("segcap: ") + what + ": " + cudaGetErrorString(e);
+    return false;
+}
+
+bool write_file(const std::string& path, const std::vector<float>& v, std::string& err) {
+    std::FILE* f = std::fopen(path.c_str(), "wb");
+    if (f == nullptr) {
+        err = "segcap: cannot write " + path;
+        return false;
+    }
+    const bool w = std::fwrite(v.data(), sizeof(float), v.size(), f) == v.size();
+    std::fclose(f);
+    if (!w) err = "segcap: short write " + path;
+    return w;
+}
+}  // namespace
+
+SegCap& segcap() {
+    static SegCap s;
+    return s;
+}
+
+bool segcap_begin(int64_t n_gdn, int64_t max_t, std::string& err) {
+    SegCap& s = segcap();
+    if (n_gdn <= 0 || max_t <= 0) {
+        err = "segcap: nothing to capture";
+        return false;
+    }
+    if (s.T == nullptr || s.n_gdn < n_gdn) {
+        if (s.T) cudaFree(s.T);
+        s.T = nullptr;
+        if (!ok(cudaMalloc(&s.T, (size_t) n_gdn * NST * sizeof(float)), "T", err)) return false;
+        s.n_gdn = n_gdn;
+    }
+    if (s.max_t < max_t) {
+        if (s.hz) cudaFree(s.hz);
+        if (s.yz) cudaFree(s.yz);
+        s.hz = s.yz = nullptr;
+        if (!ok(cudaMalloc(&s.hz, (size_t) max_t * C * sizeof(float)), "hz", err)) return false;
+        if (!ok(cudaMalloc(&s.yz, (size_t) max_t * HV * S * sizeof(float)), "yz", err)) return false;
+        s.max_t = max_t;
+    }
+    std::vector<float> I(NST, 0.0f);   // identity per v-head: element [i][h][i] = 1
+    for (int64_t h = 0; h < HV; ++h)
+        for (int64_t i = 0; i < S; ++i) I[((size_t) i * HV + h) * S + i] = 1.0f;
+    for (int64_t l = 0; l < n_gdn; ++l)
+        if (!ok(cudaMemcpy(s.T + (size_t) l * NST, I.data(), NST * sizeof(float), cudaMemcpyHostToDevice), "identity",
+                err))
+            return false;
+    s.calls = s.tokens = 0;
+    s.overflow = false;
+    s.active = true;
+    return true;
+}
+
+void segcap_layer(int64_t gdn_ord, const float* h, const float* gate, const float* beta, int64_t T, void* stream) {
+    SegCap& s = segcap();
+    if (!s.active) return;
+    if (T > s.max_t || gdn_ord < 0 || gdn_ord >= s.n_gdn) {
+        s.overflow = true;
+        return;
+    }
+    const cudaStream_t st = (cudaStream_t) stream;
+    cudaMemcpyAsync(s.hz, h, (size_t) T * C * sizeof(float), cudaMemcpyDeviceToDevice, st);
+    // v columns of every row: [2*HK*S, C)
+    cudaMemset2DAsync(s.hz + 2 * HK * S, (size_t) C * sizeof(float), 0, (size_t) (C - 2 * HK * S) * sizeof(float),
+                      (size_t) T, st);
+    gdn_recurrence_state_only(s.T + (size_t) gdn_ord * NST, s.hz, gate, beta, s.yz, T, stream);
+    ++s.calls;
+    if (gdn_ord == 0) s.tokens += T;
+}
+
+bool segcap_end(const std::string& path, std::string& err) {
+    SegCap& s = segcap();
+    s.active = false;
+    if (!ok(cudaDeviceSynchronize(), "sync", err)) return false;
+    if (s.overflow) {
+        err = "segcap: a chunk was larger than the scratch: capture invalid";
+        return false;
+    }
+    std::vector<float> host((size_t) s.n_gdn * NST);
+    if (!ok(cudaMemcpy(host.data(), s.T, host.size() * sizeof(float), cudaMemcpyDeviceToHost), "T D2H", err))
+        return false;
+    return write_file(path, host, err);
+}
+
+bool segcap_dump(const float* dev, uint64_t floats, const std::string& path, std::string& err) {
+    if (!ok(cudaDeviceSynchronize(), "sync", err)) return false;
+    std::vector<float> host((size_t) floats);
+    if (!ok(cudaMemcpy(host.data(), dev, host.size() * sizeof(float), cudaMemcpyDeviceToHost), "state D2H", err))
+        return false;
+    return write_file(path, host, err);
+}
+
+}  // namespace strata::prefill
diff --git a/engine/src/prefill/segcompose.cu b/engine/src/prefill/segcompose.cu
new file mode 100644
index 000000000..3d5fe0e2c
--- /dev/null
+++ b/engine/src/prefill/segcompose.cu
@@ -0,0 +1,275 @@
+// src/prefill/segcompose.cu - F1.3 (file state cache, research build): save a captured span's QSA state, and compose a
+// captured span into another sequence at a shifted position.  See include/strata/prefill/segcap.hpp.
+//
+// Layouts (kv_q8.hpp, qsa.hpp): codes [page][kv_head][page_size][head_dim] int8, scales [page][kv_head][page_size]
+// [head_dim/64] fp16 bits; cell t -> page = page_table[t / page_size].  Keys are stored AFTER RoPE (NEOX: dim i pairs
+// with i + n_rot/2 inside the first n_rot dims); with n_rot = 64 the rotated slice is exactly scale group 0, so a shift
+// by D re-rotates that group (dequantise, rotate by D, requantise) and leaves groups 1..3 and all of V untouched.
+// Pooled indexer keys: fp32 rows of idx_dim, block b rotated at the block's first cell, same pairing.
+#include "strata/prefill/segcap.hpp"
+#include <cuda_runtime.h>
+#include <cuda_fp16.h>
+#include <cmath>
+#include <cstdio>
+#include <vector>
+
+namespace strata::prefill {
+namespace {
+constexpr int HD = 256, NKV = 2, G = 64, NG = HD / G, NROT = 64, IDX = 128;
+constexpr int64_t S = 128, HV = 48;
+constexpr uint64_t NST = (uint64_t) S * HV * S, CONV = 10240 * 3;
+
+bool ok(cudaError_t e, const char* what, std::string& err) {
+    if (e == cudaSuccess) return true;
+    err = std::string("segcompose: ") + what + ": " + cudaGetErrorString(e);
+    return false;
+}
+
+__device__ inline size_t cell_row(const int32_t* table, int64_t t, int page_size, int h) {
+    const int64_t page = table[t / page_size];
+    return ((size_t) page * NKV + h) * page_size + (size_t) (t % page_size);
+}
+
+// one block per (cell, head): copy codes and scales of cells [a, a + n) into a compact buffer
+__global__ void kv_gather(const int8_t* kq, const int8_t* vq, const uint16_t* ks, const uint16_t* vs, const int32_t* table,
+                          int page_size, int64_t a, int8_t* ok_, int8_t* ov_, uint16_t* oks, uint16_t* ovs) {
+    const int64_t c = blockIdx.x;
+    const int h = blockIdx.y;
+    const size_t row = cell_row(table, a + c, page_size, h), dst = (size_t) c * NKV + h;
+    for (int d = threadIdx.x; d < HD; d += blockDim.x) {
+        ok_[dst * HD + d] = kq[row * HD + d];
+        ov_[dst * HD + d] = vq[row * HD + d];
+    }
+    if (threadIdx.x < NG) {
+        oks[dst * NG + threadIdx.x] = ks[row * NG + threadIdx.x];
+        ovs[dst * NG + threadIdx.x] = vs[row * NG + threadIdx.x];
+    }
+}
+
+__device__ inline float h2f(uint16_t b) { return __half2float(__ushort_as_half(b)); }
+__device__ inline uint16_t f2h(float f) { return __half_as_ushort(__float2half(f)); }
+
+// one block (64 threads) per (cell, head): scatter into cells [a, a + n), K group 0 re-rotated by D
+__global__ void kv_scatter_shift(int8_t* kq, int8_t* vq, uint16_t* ks, uint16_t* vs, const int32_t* table, int page_size,
+                                 int64_t a, const int8_t* ik, const int8_t* iv, const uint16_t* iks, const uint16_t* ivs,
+                                 const float* cos_tab, const float* sin_tab, int64_t D) {
+    const int64_t c = blockIdx.x;
+    const int h = blockIdx.y;
+    const size_t row = cell_row(table, a + c, page_size, h), src = (size_t) c * NKV + h;
+    for (int d = threadIdx.x; d < HD; d += blockDim.x) {
+        vq[row * HD + d] = iv[src * HD + d];
+        if (d >= G) kq[row * HD + d] = ik[src * HD + d];
+    }
+    if (threadIdx.x < NG) {
+        vs[row * NG + threadIdx.x] = ivs[src * NG + threadIdx.x];
+        if (threadIdx.x > 0) ks[row * NG + threadIdx.x] = iks[src * NG + threadIdx.x];
+    }
+    __shared__ float x[G];
+    __shared__ float amax[G];
+    const int i = threadIdx.x;   // 0..63
+    const float sc = h2f(iks[src * NG + 0]);
+    x[i] = (float) ik[src * HD + i] * sc;
+    __syncthreads();
+    float y = x[i];
+    if (i < NROT / 2) {
+        const int64_t p = D >= 0 ? D : -D;
+        const float cs = cos_tab[p * (NROT / 2) + i], sn = (D >= 0 ? 1.0f : -1.0f) * sin_tab[p * (NROT / 2) + i];
+        y = x[i] * cs - x[i + NROT / 2] * sn;
+    } else if (i < NROT) {
+        const int j = i - NROT / 2;
+        const int64_t p = D >= 0 ? D : -D;
+        const float cs = cos_tab[p * (NROT / 2) + j], sn = (D >= 0 ? 1.0f : -1.0f) * sin_tab[p * (NROT / 2) + j];
+        y = x[j] * sn + x[i] * cs;
+    }
+    __syncthreads();
+    x[i] = y;
+    amax[i] = fabsf(y);
+    __syncthreads();
+    for (int s = G / 2; s > 0; s >>= 1) {
+        if (i < s) amax[i] = fmaxf(amax[i], amax[i + s]);
+        __syncthreads();
+    }
+    const uint16_t nsb = f2h(amax[0] / 127.0f);
+    const float ns = h2f(nsb);
+    const float q = ns > 0.0f ? rintf(x[i] / ns) : 0.0f;
+    kq[row * HD + i] = (int8_t) fminf(127.0f, fmaxf(-127.0f, q));
+    if (i == 0) ks[row * NG + 0] = nsb;
+}
+
+// pooled rows: out[r] = rotate(in[r], D) on the first NROT dims
+__global__ void pooled_shift(float* pooled, int64_t row0, const float* in, int64_t n, const float* cos_tab,
+                             const float* sin_tab, int64_t D) {
+    const int64_t r = blockIdx.x;
+    const int i = threadIdx.x;   // 0..127
+    const float* src = in + r * IDX;
+    float y = src[i];
+    const int64_t p = D >= 0 ? D : -D;
+    const float sg = D >= 0 ? 1.0f : -1.0f;
+    if (i < NROT / 2) {
+        y = src[i] * cos_tab[p * (NROT / 2) + i] - src[i + NROT / 2] * sg * sin_tab[p * (NROT / 2) + i];
+    } else if (i < NROT) {
+        const int j = i - NROT / 2;
+        y = src[j] * sg * sin_tab[p * (NROT / 2) + j] + src[i] * cos_tab[p * (NROT / 2) + j];
+    }
+    pooled[(row0 + r) * IDX + i] = y;
+}
+
+// W_new = Wa + T (Wc - Wb) per layer and v-head; recurrent part only.  One thread per (l, i, h, j).
+__global__ void gdn_compose(const float* T, const float* Wb, const float* Wa, const float* Wc, float* out, int64_t L,
+                            uint64_t stride, int use_cur) {
+    const uint64_t idx = (uint64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= (uint64_t) L * NST) return;
+    const uint64_t l = idx / NST, e = idx % NST;
+    const uint64_t i = e / (HV * S), h = (e / S) % HV, j = e % S;
+    const float* Tl = T + l * NST;
+    const float* Bl = Wb + l * stride;
+    const float* Cl = Wc + l * stride;
+    double acc = Wa[l * stride + e];
+    for (uint64_t m = 0; m < (uint64_t) S; ++m) {
+        const uint64_t tm = (i * HV + h) * S + m, wm = (m * HV + h) * S + j;
+        acc += (double) Tl[tm] * ((use_cur ? (double) Cl[wm] : 0.0) - (double) Bl[wm]);
+    }
+    out[l * NST + e] = (float) acc;
+}
+
+bool read_file(const std::string& path, std::vector<char>& v, std::string& err) {
+    std::FILE* f = std::fopen(path.c_str(), "rb");
+    if (!f) { err = "segcompose: cannot read " + path; return false; }
+    std::fseek(f, 0, SEEK_END);
+    const long n = std::ftell(f);
+    std::fseek(f, 0, SEEK_SET);
+    v.resize((size_t) n);
+    const bool r = std::fread(v.data(), 1, v.size(), f) == v.size();
+    std::fclose(f);
+    if (!r) err = "segcompose: short read " + path;
+    return r;
+}
+
+bool write_file(const std::string& path, const void* p, size_t n, std::string& err) {
+    std::FILE* f = std::fopen(path.c_str(), "wb");
+    if (!f) { err = "segcompose: cannot write " + path; return false; }
+    const bool w = std::fwrite(p, 1, n, f) == n;
+    std::fclose(f);
+    if (!w) err = "segcompose: short write " + path;
+    return w;
+}
+
+template <class X>
+bool to_dev(const std::vector<char>& h, X** d, std::string& err) {
+    if (!ok(cudaMalloc((void**) d, h.size()), "malloc", err)) return false;
+    return ok(cudaMemcpy(*d, h.data(), h.size(), cudaMemcpyHostToDevice), "H2D", err);
+}
+}  // namespace
+
+bool segcap_save_qsa(const std::vector<SegQsa>& layers, int page_size, int64_t a, int64_t e, const float* ple_hist,
+                     uint64_t ple_floats, const std::string& dir, std::string& err) {
+    if (!ok(cudaDeviceSynchronize(), "sync", err)) return false;
+    const int64_t n = e - a;
+    const size_t codes = (size_t) n * NKV * HD, scales = (size_t) n * NKV * NG;
+    std::vector<char> blob;
+    int8_t *dk, *dv;
+    uint16_t *dks, *dvs;
+    if (!ok(cudaMalloc(&dk, codes), "malloc", err) || !ok(cudaMalloc(&dv, codes), "malloc", err) ||
+        !ok(cudaMalloc(&dks, scales * 2), "malloc", err) || !ok(cudaMalloc(&dvs, scales * 2), "malloc", err))
+        return false;
+    const int64_t b0 = a / 4, b1 = e / 4;
+    for (const SegQsa& q : layers) {
+        kv_gather<<<dim3((unsigned) n, NKV), 64>>>(q.k_q, q.v_q, q.k_scale, q.v_scale, q.page_table, page_size, a, dk, dv,
+                                                    dks, dvs);
+        if (!ok(cudaDeviceSynchronize(), "gather", err)) return false;
+        const size_t off = blob.size();
+        const size_t pooled = (size_t) (b1 - b0) * IDX * sizeof(float);
+        blob.resize(off + 2 * codes + 2 * scales * 2 + pooled);
+        char* p = blob.data() + off;
+        if (!ok(cudaMemcpy(p, dk, codes, cudaMemcpyDeviceToHost), "D2H", err) ||
+            !ok(cudaMemcpy(p + codes, dv, codes, cudaMemcpyDeviceToHost), "D2H", err) ||
+            !ok(cudaMemcpy(p + 2 * codes, dks, scales * 2, cudaMemcpyDeviceToHost), "D2H", err) ||
+            !ok(cudaMemcpy(p + 2 * codes + scales * 2, dvs, scales * 2, cudaMemcpyDeviceToHost), "D2H", err) ||
+            !ok(cudaMemcpy(p + 2 * codes + 4 * scales, q.pooled + (size_t) b0 * IDX, pooled, cudaMemcpyDeviceToHost), "D2H",
+                err))
+            return false;
+    }
+    cudaFree(dk); cudaFree(dv); cudaFree(dks); cudaFree(dvs);
+    std::vector<float> ple((size_t) ple_floats);
+    if (ple_floats && !ok(cudaMemcpy(ple.data(), ple_hist, ple_floats * 4, cudaMemcpyDeviceToHost), "ple D2H", err))
+        return false;
+    char meta[128];
+    const int m = std::snprintf(meta, sizeof meta, "%lld %lld %d %zu\n", (long long) a, (long long) e, page_size,
+                                layers.size());
+    return write_file(dir + "/qsa.bin", blob.data(), blob.size(), err) &&
+           write_file(dir + "/ple.f32", ple.data(), ple.size() * 4, err) && write_file(dir + "/meta.txt", meta, (size_t) m, err);
+}
+
+bool segcomp_apply(const std::string& dir, int64_t a, int64_t e, float* gdn_state, int64_t n_gdn,
+                   const std::vector<SegQsa>& layers, int page_size, float* ple_hist, uint64_t ple_floats, double* ms,
+                   std::string& err, bool use_t) {
+    cudaEvent_t t0, t1;
+    cudaEventCreate(&t0);
+    cudaEventCreate(&t1);
+    // meta: the captured span
+    std::vector<char> meta;
+    if (!read_file(dir + "/meta.txt", meta, err)) return false;
+    meta.push_back('\0');
+    long long ca = 0, ce = 0;
+    int cps = 0;
+    size_t cl = 0;
+    if (std::sscanf(meta.data(), "%lld %lld %d %zu", &ca, &ce, &cps, &cl) != 4) { err = "segcompose: bad meta"; return false; }
+    const int64_t n = e - a, D = a - ca;
+    if (ce - ca != n || cps != page_size || cl != layers.size() || a % 4 || e % 4 || D % 4) {
+        err = "segcompose: span mismatch (captured [" + std::to_string(ca) + "," + std::to_string(ce) + "), asked [" +
+              std::to_string(a) + "," + std::to_string(e) + "), both ends must be multiples of 4)";
+        return false;
+    }
+    std::vector<char> hT, hB, hA, hQ, hP;
+    if (!read_file(dir + "/T.f32", hT, err) || !read_file(dir + "/before.f32", hB, err) ||
+        !read_file(dir + "/after.f32", hA, err) || !read_file(dir + "/qsa.bin", hQ, err) || !read_file(dir + "/ple.f32", hP, err))
+        return false;
+    const uint64_t stride = NST + CONV;
+    if (hT.size() != (size_t) n_gdn * NST * 4 || hB.size() != (size_t) n_gdn * stride * 4 || hA.size() != hB.size()) {
+        err = "segcompose: GDN file sizes";
+        return false;
+    }
+    float *dT, *dB, *dA, *dOut;
+    char* dQ;
+    if (!to_dev(hT, &dT, err) || !to_dev(hB, &dB, err) || !to_dev(hA, &dA, err) || !to_dev(hQ, &dQ, err) ||
+        !ok(cudaMalloc(&dOut, (size_t) n_gdn * NST * 4), "malloc", err))
+        return false;
+    cudaEventRecord(t0);
+    // 1. GDN recurrent state + conv rows
+    const uint64_t tot = (uint64_t) n_gdn * NST;
+    gdn_compose<<<(unsigned) ((tot + 255) / 256), 256>>>(dT, dB, dA, gdn_state, dOut, n_gdn, stride, use_t ? 1 : 0);
+    for (int64_t l = 0; l < n_gdn; ++l) {
+        cudaMemcpy(gdn_state + l * stride, dOut + l * NST, NST * 4, cudaMemcpyDeviceToDevice);
+        cudaMemcpy(gdn_state + l * stride + NST, dA + l * stride + NST, CONV * 4, cudaMemcpyDeviceToDevice);
+    }
+    // 2. QSA layers: K/V cells and pooled indexer rows
+    const size_t codes = (size_t) n * NKV * HD, scales = (size_t) n * NKV * NG, pooled = (size_t) (n / 4) * IDX * 4;
+    size_t off = 0;
+    for (const SegQsa& q : layers) {
+        const char* p = dQ + off;
+        // the spare slot (constant for the sequence) moves from row a/4 to row e/4 before the block rows are written
+        cudaMemcpy(q.pooled + (size_t) (e / 4) * IDX, q.pooled + (size_t) (a / 4) * IDX, IDX * 4, cudaMemcpyDeviceToDevice);
+        kv_scatter_shift<<<dim3((unsigned) n, NKV), 64>>>(q.k_q, q.v_q, q.k_scale, q.v_scale, q.page_table, page_size, a,
+                                                           (const int8_t*) p, (const int8_t*) (p + codes),
+                                                           (const uint16_t*) (p + 2 * codes),
+                                                           (const uint16_t*) (p + 2 * codes + scales * 2), q.cos_tab,
+                                                           q.sin_tab, D);
+        pooled_shift<<<(unsigned) (n / 4), IDX>>>(q.pooled, a / 4, (const float*) (p + 2 * codes + 4 * scales), n / 4,
+                                                  q.cos_tab, q.sin_tab, D);
+        off += 2 * codes + 4 * scales + pooled;
+    }
+    // 3. PLE history at the span's end
+    if (ple_floats && hP.size() == ple_floats * 4)
+        cudaMemcpy(ple_hist, hP.data(), hP.size(), cudaMemcpyHostToDevice);
+    cudaEventRecord(t1);
+    const bool good = ok(cudaDeviceSynchronize(), "compose", err);
+    float f = 0;
+    cudaEventElapsedTime(&f, t0, t1);
+    if (ms) *ms = f;
+    cudaFree(dT); cudaFree(dB); cudaFree(dA); cudaFree(dOut); cudaFree(dQ);
+    cudaEventDestroy(t0);
+    cudaEventDestroy(t1);
+    return good;
+}
+
+}  // namespace strata::prefill
diff --git a/engine/src/program/generate.cpp b/engine/src/program/generate.cpp
index 08273c35c..3412ace8f 100644
--- a/engine/src/program/generate.cpp
+++ b/engine/src/program/generate.cpp
@@ -104,6 +104,7 @@
 #include "strata/core/draft_cap.hpp"
 #endif
 #include "strata/prefill/gemm.hpp"
+#include "strata/prefill/segcap.hpp"   // F1: file state capture
 #include "strata/prefill/kva.hpp"
 #include "strata/prefill/kva_floor.hpp"
 #include "strata/prefill/prefill.hpp"
@@ -17739,6 +17740,10 @@ int main(int argc, char** argv) {
             // a parked conversation holding it stays parked) and a later request that resumes from it does not park the
             // branch it leaves: N queries cost one prefix, not N.  Absent = as before.
             int64_t req_pin = 0;
+            int64_t req_seg_a = -1, req_seg_b = -1;   // F1: seg=A:B, capture the span's GDN operator
