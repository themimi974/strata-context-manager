diff --git a/engine/include/strata/prefill/segcap.hpp b/engine/include/strata/prefill/segcap.hpp
new file mode 100644
index 000000000..df518daee
--- /dev/null
+++ b/engine/include/strata/prefill/segcap.hpp
@@ -0,0 +1,61 @@
+// include/strata/prefill/segcap.hpp - F1 (file state cache) capture: while a marked prompt span is read, every GDN
+// layer also runs its state-only recurrence from the identity with v = 0, which leaves the span's transition operator
+// T_C in a per-layer buffer (W_after = T_C W_before + S(C|0); verified by gdn_compose_check).
+//
+// Research build only (branch f1-file-state).  Off unless a request carries seg=A:B; then the serve loop calls
+// segcap_begin before reading [A, B) as one batched part and segcap_end after it, and the prompt path calls
+// segcap_layer once per GDN layer per chunk.  Buffers are allocated in segcap_begin, never inside the layer loop.
+#pragma once
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace strata::prefill {
+
+struct SegCap {
+    bool active = false;
+    int64_t n_gdn = 0;          ///< GDN layers whose operator is kept (the session's gdn_alloc)
+    int64_t max_t = 0;          ///< largest chunk the scratch holds
+    float* T = nullptr;         ///< (n_gdn, 128, 48, 128) fp32, j fastest - the state layout
+    float* hz = nullptr;        ///< (max_t, 10240): the chunk's conv output with the v columns zeroed
+    float* yz = nullptr;        ///< (max_t, 48, 128): the recurrence's y scratch (unused output)
+    int64_t calls = 0;          ///< segcap_layer calls since segcap_begin (36 x chunks expected)
+    int64_t tokens = 0;         ///< tokens seen by GDN layer 0 since segcap_begin
+    bool overflow = false;      ///< a chunk was larger than max_t: the capture is invalid
+};
+
+SegCap& segcap();
+
+/// Allocates (once, grow-only) and sets every layer's operator to the identity. max_t: the largest chunk expected.
+bool segcap_begin(int64_t n_gdn, int64_t max_t, std::string& err);
+/// One GDN layer's chunk: copies h, zeroes its v columns and runs the state-only recurrence into T[gdn_ord].
+void segcap_layer(int64_t gdn_ord, const float* h, const float* gate, const float* beta, int64_t T, void* stream);
+/// Synchronizes, writes T (n_gdn x layer floats) to `path`, turns the capture off.
+bool segcap_end(const std::string& path, std::string& err);
+/// Synchronizes and writes `floats` floats of device memory to `path` (the GDN state before / after the span).
+bool segcap_dump(const float* dev, uint64_t floats, const std::string& path, std::string& err);
+
+/// One QSA layer's device pointers (filled from core::QsaState by the caller; INT8 KV, all pages resident).
+struct SegQsa {
+    int8_t* k_q;
+    int8_t* v_q;
+    uint16_t* k_scale;
+    uint16_t* v_scale;
+    const int32_t* page_table;
+    float* pooled;
+    const float* cos_tab;
+    const float* sin_tab;
+};
+
+/// F1.3 capture, at the span's end: the span's K/V cells and scales, its pooled indexer rows (both ends multiples of 4)
+/// and the PLE history, to dir/qsa.bin, dir/ple.f32, dir/meta.txt.
+bool segcap_save_qsa(const std::vector<SegQsa>& layers, int page_size, int64_t a, int64_t e, const float* ple_hist,
+                     uint64_t ple_floats, const std::string& dir, std::string& err);
+/// F1.3 compose: instead of reading [a, e), set the GDN state to W_after + T (W - W_before) (conv rows: the capture's),
+/// write the captured K/V into cells [a, e) re-rotated by a - captured_a, the pooled rows likewise (the spare slot moved
+/// to row e/4), and the PLE history.  The caller sets ple_prev.  `ms`: GPU time of the composition.
+bool segcomp_apply(const std::string& dir, int64_t a, int64_t e, float* gdn_state, int64_t n_gdn,
+                   const std::vector<SegQsa>& layers, int page_size, float* ple_hist, uint64_t ple_floats, double* ms,
+                   std::string& err, bool use_t = true);
+
+}  // namespace strata::prefill
diff --git a/engine/src/kernels/gdn_compose_check.cpp b/engine/src/kernels/gdn_compose_check.cpp
new file mode 100644
index 000000000..b7629bb56
--- /dev/null
+++ b/engine/src/kernels/gdn_compose_check.cpp
@@ -0,0 +1,174 @@
+// src/kernels/gdn_compose_check.cpp - F1.1 (file state cache): the GDN prompt recurrence is affine in its starting
+// state, and the existing kernel computes the transition operator when started from the identity with v = 0.
+//
+// For one segment of T tokens (fixed q, k, v, gate, beta) the recurrence per head and value column j is
+//     W_t[:, j] = a_t (I - beta_t k_t k_t^T) W_{t-1}[:, j] + beta_t k_t v_t[j]
+// so  W_end = T_C W_0 + S(C|0)  with  T_C = A_T ... A_1 (128 x 128 per v-head).
+// Because the state has exactly 128 value columns, running the unchanged kernel from W_0 = I with v = 0 leaves
+// T_C in the state, and running it from W_0 = 0 leaves S(C|0).  This test checks, on the real dispatch
+// (`gdn_recurrence`, the path the prompt uses on this GPU), that
+//   1. W_end(W_0) == T_C W_0 + S(C|0)                          (affinity, FP32 level)
+//   2. T_{AB} == T_B T_A and S_{AB} == T_B S_A + S_B             (two segments chain)
+// GPU, synthetic, no model, < 100 MB of device memory.
+#include "strata/prefill/kernels.hpp"
+#include <cuda_runtime.h>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <vector>
+
+namespace {
+constexpr int S = 128, HK = 16, HV = 48, C = 10240;
+constexpr size_t NST = (size_t) S * HV * S;   // state floats: [i][h][j], j fastest
+
+struct Rng {
+    uint64_t s = 0x9e3779b97f4a7c15ull;
+    float uni() {
+        s ^= s << 13; s ^= s >> 7; s ^= s << 17;
+        return (float) ((s >> 11) * (1.0 / 9007199254740992.0));
+    }
+};
+
+void check(cudaError_t e, const char* what) {
+    if (e != cudaSuccess) {
+        std::fprintf(stderr, "gdn_compose_check: %s: %s\n", what, cudaGetErrorString(e));
+        std::exit(1);
+    }
+}
+
+struct Seg {
+    int T;
+    std::vector<float> h, gate, beta, z;
+};
+
+Seg make_seg(Rng& rng, int T, float gate_lo, float gate_span) {
+    Seg s{T, std::vector<float>((size_t) T * C), std::vector<float>((size_t) T * HV), std::vector<float>((size_t) T * HV),
+          std::vector<float>((size_t) T * HV * S)};
+    for (int t = 0; t < T; ++t) {
+        for (int qh = 0; qh < HK; ++qh)
+            for (int part = 0; part < 2; ++part) {
+                double ss = 0;
+                float row[S];
+                for (int i = 0; i < S; ++i) { row[i] = rng.uni() - 0.5f; ss += (double) row[i] * row[i]; }
+                const float nrm = (float) (1.0 / std::sqrt(ss + 1e-5));
+                for (int i = 0; i < S; ++i) s.h[(size_t) t * C + (part ? HK * S : 0) + qh * S + i] = row[i] * nrm;
+            }
+        for (int hh = 0; hh < HV; ++hh) {
+            for (int j = 0; j < S; ++j) s.h[(size_t) t * C + 2 * HK * S + hh * S + j] = rng.uni() - 0.5f;
+            s.gate[(size_t) t * HV + hh] = -(gate_lo + gate_span * rng.uni());
+            s.beta[(size_t) t * HV + hh] = 1.0f / (1.0f + std::exp(-(4.0f * rng.uni() - 2.0f)));
+            for (int j = 0; j < S; ++j) s.z[((size_t) t * HV + hh) * S + j] = 2.0f * rng.uni() - 1.0f;
+        }
+    }
+    return s;
+}
+
+struct Dev {
+    float *st, *h, *g, *b, *z, *ga, *y;
+    uint16_t* y16;
+    int Tmax;
+};
+
+// Runs the real prompt recurrence over `seg` from `st0`; zero_v replaces every v row by zeros.
+std::vector<float> run(Dev& d, const Seg& seg, const std::vector<float>& st0, const std::vector<float>& gamma,
+                       bool zero_v) {
+    std::vector<float> h = seg.h;
+    if (zero_v)
+        for (int t = 0; t < seg.T; ++t)
+            for (int c = 2 * HK * S; c < C; ++c) h[(size_t) t * C + c] = 0.0f;
+    check(cudaMemcpy(d.st, st0.data(), NST * 4, cudaMemcpyHostToDevice), "H2D st");
+    check(cudaMemcpy(d.h, h.data(), h.size() * 4, cudaMemcpyHostToDevice), "H2D h");
+    check(cudaMemcpy(d.g, seg.gate.data(), seg.gate.size() * 4, cudaMemcpyHostToDevice), "H2D g");
+    check(cudaMemcpy(d.b, seg.beta.data(), seg.beta.size() * 4, cudaMemcpyHostToDevice), "H2D b");
+    check(cudaMemcpy(d.z, seg.z.data(), seg.z.size() * 4, cudaMemcpyHostToDevice), "H2D z");
+    check(cudaMemcpy(d.ga, gamma.data(), gamma.size() * 4, cudaMemcpyHostToDevice), "H2D gamma");
+    strata::prefill::gdn_recurrence(d.st, d.h, d.g, d.b, d.z, d.ga, 1e-5f, d.y, d.y16, seg.T, nullptr);
+    check(cudaDeviceSynchronize(), "sync");
+    std::vector<float> out(NST);
+    check(cudaMemcpy(out.data(), d.st, NST * 4, cudaMemcpyDeviceToHost), "D2H st");
+    return out;
+}
+
+std::vector<float> identity() {
+    std::vector<float> I(NST, 0.0f);
+    for (int h = 0; h < HV; ++h)
+        for (int i = 0; i < S; ++i) I[((size_t) i * HV + h) * S + i] = 1.0f;
+    return I;
+}
+
+// out = A W (+ add), per head: out[i][h][j] = sum_m A[i][h][m] W[m][h][j]
+std::vector<float> apply(const std::vector<float>& A, const std::vector<float>& W, const std::vector<float>* add) {
+    std::vector<float> out(NST, 0.0f);
+    for (int h = 0; h < HV; ++h)
+        for (int i = 0; i < S; ++i)
+            for (int j = 0; j < S; ++j) {
+                double acc = add ? (*add)[((size_t) i * HV + h) * S + j] : 0.0;
+                for (int m = 0; m < S; ++m)
+                    acc += (double) A[((size_t) i * HV + h) * S + m] * W[((size_t) m * HV + h) * S + j];
+                out[((size_t) i * HV + h) * S + j] = (float) acc;
+            }
+    return out;
+}
+
+double rel_err(const std::vector<float>& a, const std::vector<float>& b) {
+    double num = 0, den = 0;
+    for (size_t i = 0; i < a.size(); ++i) { num += (double) (a[i] - b[i]) * (a[i] - b[i]); den += (double) b[i] * b[i]; }
+    return std::sqrt(num / (den + 1e-30));
+}
+
+double frob(const std::vector<float>& a) {
+    double s = 0;
+    for (float x : a) s += (double) x * x;
+    return std::sqrt(s);
+}
+}  // namespace
+
+int main(int argc, char** argv) {
+    const int T1 = argc > 1 ? std::atoi(argv[1]) : 300;
+    const int T2 = argc > 2 ? std::atoi(argv[2]) : 200;
+    const float gate_lo = argc > 3 ? (float) std::atof(argv[3]) : 0.02f;    // -gate in [lo, lo + span]
+    const float gate_span = argc > 4 ? (float) std::atof(argv[4]) : 0.3f;
+    Rng rng;
+    Seg A = make_seg(rng, T1, gate_lo, gate_span), B = make_seg(rng, T2, gate_lo, gate_span);
+    std::vector<float> gamma(S);
+    for (int j = 0; j < S; ++j) gamma[j] = 0.5f + 2.0f * rng.uni();
+    std::vector<float> W0(NST);
+    for (float& x : W0) x = 0.1f * (rng.uni() - 0.5f);
+
+    Dev d{};
+    const int Tmax = T1 > T2 ? T1 : T2;
+    check(cudaMalloc(&d.st, NST * 4), "malloc");
+    check(cudaMalloc(&d.h, (size_t) Tmax * C * 4), "malloc");
+    check(cudaMalloc(&d.g, (size_t) Tmax * HV * 4), "malloc");
+    check(cudaMalloc(&d.b, (size_t) Tmax * HV * 4), "malloc");
+    check(cudaMalloc(&d.z, (size_t) Tmax * HV * S * 4), "malloc");
+    check(cudaMalloc(&d.ga, S * 4), "malloc");
+    check(cudaMalloc(&d.y, (size_t) Tmax * HV * S * 4), "malloc");
+    check(cudaMalloc(&d.y16, (size_t) Tmax * HV * S * 2), "malloc");
+    d.Tmax = Tmax;
+
+    const std::vector<float> I = identity(), Z(NST, 0.0f);
+    // 1. affinity on segment A
+    const std::vector<float> W1 = run(d, A, W0, gamma, false);
+    const std::vector<float> TA = run(d, A, I, gamma, true);
+    const std::vector<float> SA = run(d, A, Z, gamma, false);
+    const std::vector<float> W1p = apply(TA, W0, &SA);
+    const double e1 = rel_err(W1p, W1);
+    // 2. chaining A then B
+    const std::vector<float> TB = run(d, B, I, gamma, true);
+    const std::vector<float> SB = run(d, B, Z, gamma, false);
+    const std::vector<float> W2 = run(d, B, W1, gamma, false);                    // the real A then B
+    const std::vector<float> W2p = apply(TB, apply(TA, W0, &SA), &SB);            // composed from the two operators
+    const double e2 = rel_err(W2p, W2);
+    // 3. how much the start state still matters at the end: ||T_A W0|| / ||W1||
+    const double carry = frob(apply(TA, W0, nullptr)) / (frob(W1) + 1e-30);
+
+    std::printf("segments T1=%d T2=%d, -gate in [%.3f, %.3f]\n", T1, T2, gate_lo, gate_lo + gate_span);
+    std::printf("1. affinity   rel err W_end vs T_C W0 + S(C|0): %.3e\n", e1);
+    std::printf("2. chaining   rel err [A][B] vs T_B(T_A W0 + S_A) + S_B: %.3e\n", e2);
+    std::printf("3. carry      ||T_A W0|| / ||W_end||: %.3e  (share of the end state that comes from before the segment)\n", carry);
+    const bool ok = e1 < 1e-4 && e2 < 1e-4;
+    std::printf("%s\n", ok ? "PASS" : "FAIL");
+    return ok ? 0 : 1;
+}
