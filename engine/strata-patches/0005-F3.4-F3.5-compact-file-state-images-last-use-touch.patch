+// F3.4: W_new = S0 + T W per layer and v-head, T only for the heads in `mask` (the others carry nothing over).
+__global__ void gdn_apply(const float* T, const uint8_t* mask, const float* S0, const float* W, float* out, int64_t L,
+                          uint64_t stride, int use_t) {
+    const uint64_t idx = (uint64_t) blockIdx.x * blockDim.x + threadIdx.x;
+    if (idx >= (uint64_t) L * NST) return;
+    const uint64_t l = idx / NST, e = idx % NST;
+    const uint64_t i = e / (HV * S), h = (e / S) % HV, j = e % S;
+    double acc = S0[l * NST + e];
+    if (use_t && mask[l * HV + h]) {
+        const float* Tl = T + l * NST;
+        const float* Wl = W + l * stride;
+        for (uint64_t m = 0; m < (uint64_t) S; ++m) acc += (double) Tl[(i * HV + h) * S + m] * Wl[(m * HV + h) * S + j];
+    }
+    out[l * NST + e] = (float) acc;
+}
+
+uint16_t f2bf(float f) {
+    uint32_t u;
+    std::memcpy(&u, &f, 4);
+    u += 0x7FFFu + ((u >> 16) & 1u);
+    return (uint16_t) (u >> 16);
+}
+
+float bf2f(uint16_t b) {
+    const uint32_t u = (uint32_t) b << 16;
+    float f;
+    std::memcpy(&f, &u, 4);
+    return f;
+}
+
+constexpr float T_HEAD_EPS = 1e-5f;   // a head whose operator never exceeds this carries nothing over: not stored
+
