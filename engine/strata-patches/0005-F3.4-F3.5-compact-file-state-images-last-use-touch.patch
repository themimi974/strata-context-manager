+bool segcap_finish(const std::string& dir, const float* gdn_after, int64_t n_gdn, std::string& err) {
+    SegCap& s = segcap();
+    s.active = false;
+    if (!ok(cudaDeviceSynchronize(), "sync", err)) return false;
+    if (s.overflow) { err = "segcap: a chunk was larger than the scratch: capture invalid"; return false; }
+    const uint64_t stride = NST + CONV;
+    if (s.before.size() != (size_t) n_gdn * stride || s.T == nullptr) { err = "segcap: no state before the span"; return false; }
+    float *dWb = nullptr, *dS0 = nullptr;
+    if (!ok(cudaMalloc(&dWb, s.before.size() * 4), "malloc", err) || !ok(cudaMalloc(&dS0, (size_t) n_gdn * NST * 4), "malloc", err)) {
+        if (dWb) cudaFree(dWb);
+        return false;
+    }
+    cudaMemcpy(dWb, s.before.data(), s.before.size() * 4, cudaMemcpyHostToDevice);
+    const uint64_t tot = (uint64_t) n_gdn * NST;   // S0 = W_after - T W_before (the existing kernel, no current state)
+    gdn_compose<<<(unsigned) ((tot + 255) / 256), 256>>>(s.T, dWb, gdn_after, dWb, dS0, n_gdn, stride, 0);
+    std::vector<float> hT(tot), hS0(tot), conv((size_t) n_gdn * CONV);
+    bool good = ok(cudaDeviceSynchronize(), "S0", err) &&
+                ok(cudaMemcpy(hT.data(), s.T, tot * 4, cudaMemcpyDeviceToHost), "T D2H", err) &&
+                ok(cudaMemcpy(hS0.data(), dS0, tot * 4, cudaMemcpyDeviceToHost), "S0 D2H", err);
+    for (int64_t l = 0; good && l < n_gdn; ++l)
+        good = ok(cudaMemcpy(conv.data() + (size_t) l * CONV, gdn_after + l * stride + NST, CONV * 4, cudaMemcpyDeviceToHost),
+                  "conv D2H", err);
+    cudaFree(dWb);
+    cudaFree(dS0);
+    if (!good) return false;
+    // T.bf16: "SEGT1", n_gdn, the per-head mask, then the kept heads' 128x128 operators ([i][j]) in bf16
+    std::vector<uint8_t> mask((size_t) n_gdn * HV, 0);
+    std::vector<uint16_t> tb;
+    for (int64_t l = 0; l < n_gdn; ++l)
+        for (int64_t h = 0; h < HV; ++h) {
+            float mx = 0.0f;
+            for (int64_t i = 0; i < S; ++i)
+                for (int64_t j = 0; j < S; ++j) mx = std::fmax(mx, std::fabs(hT[(size_t) l * NST + (i * HV + h) * S + j]));
+            if (mx <= T_HEAD_EPS) continue;
+            mask[(size_t) l * HV + h] = 1;
+            for (int64_t i = 0; i < S; ++i)
+                for (int64_t j = 0; j < S; ++j) tb.push_back(f2bf(hT[(size_t) l * NST + (i * HV + h) * S + j]));
+        }
+    std::vector<char> tfile(8 + mask.size() + tb.size() * 2);
+    std::memcpy(tfile.data(), "SEGT1\0\0\0", 8);
+    std::memcpy(tfile.data() + 8, mask.data(), mask.size());
+    std::memcpy(tfile.data() + 8 + mask.size(), tb.data(), tb.size() * 2);
+    std::vector<uint16_t> sb(tot);
+    for (size_t k = 0; k < tot; ++k) sb[k] = f2bf(hS0[k]);
+    s.before.clear();
+    s.before.shrink_to_fit();
+    return write_file(dir + "/T.bf16", tfile.data(), tfile.size(), err) &&
+           write_file(dir + "/S0.bf16", sb.data(), sb.size() * 2, err) &&
+           write_file(dir + "/conv.f32", conv.data(), conv.size() * 4, err);
+}
