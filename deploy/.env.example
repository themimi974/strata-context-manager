# Copy to .env (next to compose.yaml) and fill in. Generate secrets with:  openssl rand -hex 24

# --- Strata (the GPU machine) ---
STRATA_URL=http://strata-host:8080
STRATA_MODEL=openai/qwen3.8-flash-next-iq2_xs     # "openai/" + the model_name in Strata's config
MODEL_NAME=qwen3.8-flash-next                     # the name clients use

# --- secrets ---
LITELLM_MASTER_KEY=sk-change-me                   # must start with sk-
LITELLM_SALT_KEY=change-me                        # never change after the first start (encrypts stored keys)
POSTGRES_PASSWORD=change-me
CTX_DB_PASSWORD=change-me
CTX_ADMIN_TOKEN=change-me                         # the engine-side janitor sends it; same value in /etc/strata-context-token

# --- Context Manager ---
CTX_MODE=snapshot                                 # passthrough = observe only, never touch Strata
CTX_REORDER=1                                     # move volatile system-prompt lines (dates) below the stable prefix
# CTX_VOLATILE_PATTERNS=                          # one regex per line; default: Hermes' "Conversation started: ..." line
CTX_PIN_SYSTEM=0                                  # keep 0: see docs/KNOWN-ISSUES.md

# --- validity tuple: a snapshot is reused only when all of these match ---
CTX_QUANT=IQ2_XS
CTX_WEIGHTS_HASH=unknown                          # sha256 of your model files, see docs/CONFIGURATION.md
CTX_ENGINE_VERSION=unknown                        # e.g. the output of `git describe` in your Strata checkout
CTX_TEMPLATE_VERSION=unknown                      # sha256 of the chat template

# --- ports (optional) ---
# LITELLM_BIND=127.0.0.1:
# LITELLM_PORT=4000
# CONTEXT_MANAGER_PORT=8090
